DB_HOST=localhost
DB_PORT=3306
# Usuario de solo lectura (server/usuario-lectura.sql), nunca root
DB_USER=vm_lectura
DB_PASSWORD=
DB_NAME=inventario_vm
# CA de MySQL para verificar su certificado TLS (obligatorio si la BD no está en localhost).
# En MySQL 8 es <datadir>/ca.pem
# DB_SSL_CA=/ruta/a/mysql-ca.pem
PORT=3000

# Producción: HTTPS propio con el certificado del dominio…
# TLS_CERT=/ruta/a/fullchain.pem
# TLS_KEY=/ruta/a/privkey.pem
# HTTP_PORT=80
# …o detrás de un proxy que ya pone HTTPS (Nginx, Caddy, Cloudflare)
# TRUST_PROXY=1
