{
  "name": "verdemagenta",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web -c magenta,cyan \"npm:api\" \"npm:web\"",
    "web": "ng serve --proxy-config proxy.conf.json",
    "api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "fotos": "node --env-file-if-exists=.env server/fotos.mjs",
    "build": "ng build",
    "serve:prod": "ng build && node --env-file-if-exists=.env server/index.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.3.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
